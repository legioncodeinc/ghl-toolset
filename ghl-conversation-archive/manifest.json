{
  "manifest_version": 3,
  "name": "GHL Conversation Archive",
  "version": "1.0.0",
  "description": "Archives every conversation and message in a HighLevel sub-account to a folder on your machine. Export only.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Archive conversations",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
